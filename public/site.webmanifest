{
  "name": "Studio Bru Oliveira",
  "short_name": "Studio Bru",
  "description": "App oficial de treino e gestão personalizada dos professores do Studio Bru Oliveira",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0E111D",
  "theme_color": "#4B4FA0",
  "categories": ["fitness", "health", "sports", "productivity"],
  "lang": "pt-BR",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Área de Treino",
      "short_name": "Treino",
      "description": "Acessar diretamente as fichas de treino dos alunos",
      "url": "/treino",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Alunos",
      "short_name": "Alunos",
      "description": "Lista de alunos e fichas do studio",
      "url": "/alunos",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Exercícios",
      "short_name": "Exercícios",
      "description": "Biblioteca de exercícios com vídeos do YouTube",
      "url": "/exercicios",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ]
}
